    <mt:SetVar name="schedule_slot_label" value="2024年度">
    <mt:SetVar name="schedule_slot_img" value="top-img-015.png">
    <mt:SetVar name="schedule_slot_href" value="">
    <mt:Include module="azcom-information-schedule-slot">
  </div>
</div>
