<mt:Ignore>
  諮問委員会（目的）— common item

  Required（分割ラベル）:
    purpose_item_label_num   … 例: "01."
    purpose_item_label_text  … 例: "社内"

  Required（コンテンツ）:
    purpose_item_title_html または purpose_item_title … ピンク見出し
    purpose_item_body_html または purpose_item_body … 本文（グレー）

  Optional（後方互換・単一ラベル）:
    purpose_item_label … num/text 未指定時のみ表示
</mt:Ignore>

<div class="c-advisory-purpose-item">
  <span class="c-advisory-purpose-item__label">
    <mt:If name="purpose_item_label_num" ne="">
      <span class="c-advisory-purpose-item__label-num"><$mt:Var name="purpose_item_label_num" encode_html="1"$></span>
      <span class="c-advisory-purpose-item__label-text"><$mt:Var name="purpose_item_label_text" encode_html="1"$></span>
    <mt:Else>
      <span class="c-advisory-purpose-item__label-fallback"><$mt:Var name="purpose_item_label" encode_html="1"$></span>
    </mt:If>
  </span>

  <div class="c-advisory-purpose-item__content">
    <mt:If name="purpose_item_title_html" ne="">
      <p class="c-advisory-purpose-item__title"><$mt:Var name="purpose_item_title_html"$></p>
    <mt:Else>
      <mt:If name="purpose_item_title" ne="">
        <p class="c-advisory-purpose-item__title"><$mt:Var name="purpose_item_title" encode_html="1"$></p>
      </mt:If>
    </mt:If>

    <mt:If name="purpose_item_body_html" ne="">
      <div class="c-advisory-purpose-item__text"><$mt:Var name="purpose_item_body_html"$></div>
    <mt:Else>
      <p class="c-advisory-purpose-item__text"><$mt:Var name="purpose_item_body" encode_html="1"$></p>
    </mt:If>
  </div>
</div>
