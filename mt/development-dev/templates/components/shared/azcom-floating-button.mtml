<a
  class="c-floating-button c-floating-button--<$mt:Var name="floating_button_modifier" encode_html="1"$>"
  href="<$mt:Var name="floating_button_href" encode_html="1"$>"
  aria-label="<$mt:Var name="floating_button_aria_label" encode_html="1"$>"
>
  <span class="c-floating-button__icon c-floating-button__icon--<$mt:Var name="floating_button_modifier" encode_html="1"$>" aria-hidden="true">
    <img
      src="<$mt:StaticWebPath encode_html="1"$><$mt:Var name="floating_button_icon_src" encode_html="1"$>?v=<$mt:Var name="assets_version" encode_html="1"$>"
      alt=""
      width="<$mt:Var name="floating_button_icon_w" encode_html="1"$>"
      height="<$mt:Var name="floating_button_icon_h" encode_html="1"$>"
      decoding="async"
    />
  </span>
  <span class="c-floating-button__label"><$mt:Var name="floating_button_label" encode_html="1"$></span>
</a>
