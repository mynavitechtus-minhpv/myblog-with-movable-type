<mt:Ignore>
  Section 事業内容 — 3 cards via azcom-business-content-card.
  Images: replace fv-img-00x with final assets (e.g. business-content-01.png) when available.
</mt:Ignore>
<section class="c-business-content" id="business-content" aria-labelledby="business-content-heading">
  <div class="l-container">
    <header class="c-business-content__header">
      <h2 id="business-content-heading" class="c-business-content__title">事業内容</h2>
      <p class="c-business-content__lead">物流企業が抱える多様な課題に対応し、会員様とその従業員様の満足度向上をサポートします</p>
    </header>

    <ul class="c-business-content__grid">
      <!-- Card 1: 共同購入サイト -->
      <mt:SetVar name="img" value="top-img-010.png">
      <mt:SetVar name="img_alt" value="共同購入サイト">
      <mt:SetVar name="card_kicker" value="物流関連資材・オフィス用品のオンラインショップ">
      <mt:SetVar name="card_title" value="共同購入サイト">
      <mt:SetVar name="card_featured" value="0">
      <mt:SetVar name="card_href" value="#">
      <mt:Include module="azcom-business-content-card">

      <!-- Card 2: 支援メニュー (featured) -->
      <mt:SetVar name="img" value="top-img-011.png">
      <mt:SetVar name="img_alt" value="支援メニュー">
      <mt:SetVar name="card_kicker" value="研修やETC・燃料・催事など">
      <mt:SetVar name="card_title" value="支援メニュー">
      <mt:SetVar name="card_featured" value="1">
      <mt:SetVar name="card_href" value="#">
      <mt:Include module="azcom-business-content-card">

      <!-- Card 3: BCP活動 -->
      <mt:SetVar name="img" value="top-img-012.png">
      <mt:SetVar name="img_alt" value="BCP活動">
      <mt:SetVar name="card_kicker" value="大規模災害時における支援活動">
      <mt:SetVar name="card_title" value="BCP活動">
      <mt:SetVar name="card_featured" value="0">
      <mt:SetVar name="card_href" value="#">
      <mt:Include module="azcom-business-content-card">
    </ul>
  </div>
</section>
