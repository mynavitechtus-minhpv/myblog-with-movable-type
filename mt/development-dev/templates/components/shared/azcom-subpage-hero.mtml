<mt:Ignore>
  Subpage Hero (shared)
  Required: subpage_hero_bg (filename under assets/img), subpage_hero_title (H1 text).
</mt:Ignore>

<section class="c-subpage-hero" aria-label="<$mt:Var name="subpage_hero_title"$>">
  <div class="c-subpage-hero__media" aria-hidden="true">
    <img
      class="c-subpage-hero__bg"
      src="<$mt:StaticWebPath encode_html="1"$>assets/img/<$mt:Var name="subpage_hero_bg"$>"
      alt=""
      width="1920"
      loading="eager"
      decoding="async">
  </div>

  <div class="c-subpage-hero__overlay" aria-hidden="true"></div>

  <div class="c-subpage-hero__inner l-container">
    <h1 class="c-subpage-hero__title"><$mt:Var name="subpage_hero_title"$></h1>
  </div>

  <div class="c-subpage-hero__decoration" aria-hidden="true">
    <img
      class="c-subpage-hero__decoration-img c-subpage-hero__decoration-img--desktop"
      src="<$mt:StaticWebPath encode_html="1"$>assets/img/decoration-sub-001.svg"
      alt=""
      width="1920"
      height="427"
      loading="eager"
      decoding="async">
    <img
      class="c-subpage-hero__decoration-img c-subpage-hero__decoration-img--mobile"
      src="<$mt:StaticWebPath encode_html="1"$>assets/img/decoration-sub-sp-001.svg"
      alt=""
      width="767"
      height="254"
      loading="eager"
      decoding="async">
  </div>
</section>
