<mt:Ignore>
  Subpage Hero (shared)
  Required vars before include:
  - subpage_hero_bg: image filename or relative path under assets/img (e.g. sub-img-001.png)
  - subpage_hero_title: page H1 title
</mt:Ignore>

<section class="c-subpage-hero" aria-label="<$mt:Var name="subpage_hero_title"$>">
  <div class="c-subpage-hero__media" aria-hidden="true">
    <picture class="c-subpage-hero__picture">
      <img
        class="c-subpage-hero__bg"
        src="<$mt:StaticWebPath encode_html="1"$>assets/img/<$mt:Var name="subpage_hero_bg"$>"
        alt=""
        width="1440"
        height="320"
        loading="eager"
        decoding="async">
    </picture>
  </div>

  <div class="c-subpage-hero__overlay" aria-hidden="true"></div>

  <div class="c-subpage-hero__inner l-container">
    <h1 class="c-subpage-hero__title"><$mt:Var name="subpage_hero_title"$></h1>
  </div>

