<section class="c-information c-information--news" id="information" aria-labelledby="information-heading">
  <div class="l-container">
    <h2 id="information-heading" class="c-information__title">インフォメーション</h2>
    <div class="c-information-news" id="information-news" aria-labelledby="information-news-heading">
      <div class="c-information-news__card">
        <h3 id="information-news-heading" class="c-information-news__heading">お知らせ</h3>
        <mt:Blogs include_blogs="children">
          <mt:If tag="BlogName" eq="News">
            <mt:Entries lastn="$information_news_lastn" sort_by="$information_news_sort_by" sort_order="$information_news_sort_order">
              <mt:EntriesHeader>
              <ul class="c-news-list">
              </mt:EntriesHeader>
              <li class="c-news-list__item">
                <a class="c-news-list__link" href="/news/post_<$mt:EntryID encode_html="1"$>/">
                  <span class="c-news-list__body">
                    <time class="c-news-list__date" datetime="<$mt:EntryDate format_name="iso8601"$>"><$mt:EntryDate format="%Y.%m.%d"$></time>
                    <span class="c-news-list__text"><$mt:EntryTitle remove_html="1" encode_html="1"$></span>
                  </span>
                  <span class="c-news-list__icon" aria-hidden="true">
                    <img src="<$mt:StaticWebPath encode_html="1"$>assets/img/icon-arrow-004.svg" alt="" width="24" height="24" loading="lazy" decoding="async" class="c-news-list__icon-img">
                  </span>
                </a>
              </li>
              <mt:EntriesFooter>
              </ul>
              </mt:EntriesFooter>
              <mt:Else>
              <p class="c-news-list__empty" role="status">お知らせはまだありません。</p>
            </mt:Entries>
          </mt:If>
        </mt:Blogs>
      </div>
      <mt:If name="information_news_show_list_cta" ne="">
        <mt:Blogs include_blogs="children">
          <mt:If tag="BlogName" eq="News">
            <p class="c-information-news__actions">
              <a class="c-information-news__btn-more" href="/news/">お知らせ一覧</a>
            </p>
          </mt:If>
        </mt:Blogs>
      </mt:If>
    </div>
  </div>
</section>
