<mt:Ignore>
  法人概要セクション（会社情報テーブル）
</mt:Ignore>

<section class="c-company-profile" id="company-profile" aria-labelledby="company-profile-heading">
  <div class="l-container">
    <header class="c-company-profile__header">
      <mt:SetVar name="section_title_id" value="company-profile-heading">
      <mt:SetVarBlock name="section_title_text">法人概要</mt:SetVarBlock>
      <mt:Include module="azcom-section-title">
    </header>

    <dl class="c-company-profile__table" aria-label="法人概要">
      <div class="c-company-profile__row">
        <dt class="c-company-profile__term">名称</dt>
        <dd class="c-company-profile__desc">一般社団法人AZ-COMネットワーク</dd>
      </div>

      <div class="c-company-profile__row">
        <dt class="c-company-profile__term">代表理事</dt>
        <dd class="c-company-profile__desc">和佐見　勝</dd>
      </div>

      <div class="c-company-profile__row">
        <dt class="c-company-profile__term">所在地</dt>
        <dd class="c-company-profile__desc">〒100-0005　東京都千代田区丸の内1-8-2（鉄鋼ビルディング5F）</dd>
      </div>

      <div class="c-company-profile__row">
        <dt class="c-company-profile__term">設立年月日</dt>
        <dd class="c-company-profile__desc">2015年4月</dd>
      </div>

      <div class="c-company-profile__row">
        <dt class="c-company-profile__term">代表電話番号</dt>
        <dd class="c-company-profile__desc">03-3212-1111</dd>
      </div>

      <div class="c-company-profile__row">
        <dt class="c-company-profile__term">事業内容</dt>
        <dd class="c-company-profile__desc">
          <ul class="c-company-profile__list">
            <li>会員企業間の情報共有・連携を促進するネットワーク運営</li>
            <li>共同配送・共同購買等によるコスト削減とサービス品質向上の支援</li>
            <li>研修会・勉強会を通じた人材育成および経営力・現場力強化の支援</li>
            <li>会員企業の経営を支援するサービス全般</li>
          </ul>
        </dd>
      </div>

      <div class="c-company-profile__row">
        <dt class="c-company-profile__term">理事・会員</dt>
        <dd class="c-company-profile__desc">
          <p class="c-company-profile__stat">理事：6社</p>
          <p class="c-company-profile__stat">会員：3000社</p>
          <p class="c-company-profile__note">※2026年4月現在</p>
        </dd>
      </div>
    </dl>
  </div>
</section>
