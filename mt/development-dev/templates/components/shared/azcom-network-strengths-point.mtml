<mt:Ignore>
  Params: point_label, img, img_alt, point_title, point_body (SetVarBlock), point_body_html (optional raw HTML), loading
  Badge overlays top-left of image (Figma); no full-width pastel bar.
</mt:Ignore>

<li class="c-network-strengths__item">
  <div class="c-network-strengths__item-card">
    <div class="c-network-strengths__item-body">
      <div class="c-network-strengths__media-wrap">
        <span class="c-network-strengths__item-label"><$mt:Var name="point_label" encode_html="1"$></span>
        <figure class="c-network-strengths__media">
          <img src="<mt:Include module="azcom-site-root-path">assets/img/<$mt:Var name="img" encode_html="1"$>"
               alt="<$mt:Var name="img_alt" encode_html="1"$>"
               class="c-network-strengths__img"
               width="280"
               height="210"
               loading="<$mt:Var name="loading" default="lazy"$>">
        </figure>
      </div>
      <div class="c-network-strengths__content">
        <h3 class="c-network-strengths__item-title"><$mt:Var name="point_title" encode_html="1"$></h3>
        <mt:If name="point_body_html" ne="">
          <div class="c-network-strengths__item-text"><$mt:Var name="point_body_html"$></div>
        <mt:Else>
          <p class="c-network-strengths__item-text"><$mt:Var name="point_body" encode_html="1"$></p>
        </mt:If>
      </div>
    </div>
  </div>
</li>
<mt:SetVar name="point_body_html" value="">
