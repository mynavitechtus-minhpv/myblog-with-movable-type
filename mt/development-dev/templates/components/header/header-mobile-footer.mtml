<div class="c-header__mobile-footer">
  <form class="c-header__mobile-search" action="#" method="get" role="search">
    <label class="c-header__visually-hidden" for="header-mobile-search-q">サイト内検索</label>
    <span class="c-header__mobile-search-inner">
      <img class="c-header__mobile-search-icon" src="<mt:StaticWebPath>assets/img/icon-search.svg" alt="" width="20" height="20" aria-hidden="true">
      <input id="header-mobile-search-q" class="c-header__mobile-search-input" type="search" name="q" placeholder="サイト内を検索" autocomplete="off">
      <button type="button" class="c-header__mobile-search-clear" aria-label="検索語をクリア" hidden></button>
      <button type="submit" class="c-header__mobile-search-submit">検索</button>
    </span>
  </form>
  <a href="/login/" class="c-header__btn-member c-header__btn-member--mobile">会員の方はこちら</a>
  <div class="c-header__mobile-brand">
    <a href="/"><img src="<mt:StaticWebPath>assets/img/logo.svg" alt="AZ-COM NET"></a>
  </div>
  <div class="c-header__mobile-legal">
    <a href="#">利用規約</a>
    <a href="#">個人情報保護方針</a>
  </div>
</div>
