<!-- お問い合わせ種別: バックエンドでクエリ ?type= を読み取り、ラジオ（入会希望 / 資料請求 / お問合せ）の checked を設定する。
     type=membership → 入会希望 | type=materials → 資料請求 | type=contact → お問合せ -->
<section class="c-footer__contact l-container">
  <div class="c-footer__contact-bg c-footer__contact-bg--pc">
    <img src="<mt:StaticWebPath>assets/img/footer-img-001.png" alt="" loading="lazy">
  </div>
  <div class="c-footer__contact-bg c-footer__contact-bg--sp">
    <img src="<mt:StaticWebPath>assets/img/footer-sp-img-001.png" alt="" loading="lazy">
  </div>

  <div class="c-footer__contact-inner">
    <div class="c-footer__contact-heading">
      <h2 class="c-footer__contact-title">お問合せ</h2>
      <span class="c-footer__contact-accent"></span>
    </div>
    <div class="c-footer__contact-body">
      <p class="c-footer__contact-desc">ご相談・ご質問等ございましたら、どうぞお気軽にお問合せください。</p>
      <div class="c-footer__contact-actions">
        <a href="/inquiry/?type=membership" class="c-footer__contact-btn">ご入会に関するお問合せ</a>
        <a href="/inquiry/?type=materials" class="c-footer__contact-btn">資料請求</a>
        <a href="/inquiry/?type=contact" class="c-footer__contact-btn">その他</a>
      </div>
    </div>
  </div>
</section>
