<div id="js-hero-fv" class="c-hero-fv-wrap">
<section class="c-hero-fv" aria-label="メインビジュアル">
  <div class="c-hero-fv__container">

    <!-- Slide 1 -->
    <mt:SetVar name="img_pc" value="fv-img-001.png">
    <mt:SetVar name="img_sp" value="fv-sp-img-001.png">
    <mt:SetVar name="line1" value="物流の未来を、ともに創る">
    <mt:SetVar name="line2" value="">
    <mt:SetVar name="line3" value="">
    <mt:SetVar name="hero_alt" value="物流の未来を、ともに創る">
    <mt:SetVar name="loading" value="eager">
    <mt:Include module="azcom-hero-fv-item">

    <!-- Slide 2 -->
    <mt:SetVar name="img_pc" value="fv-img-002.png">
    <mt:SetVar name="img_sp" value="fv-sp-img-002.png">
    <mt:SetVar name="line1" value="物流企業の未来を">
    <mt:SetVar name="line2" value="加速させるパートナー">
    <mt:SetVar name="line3" value="">
    <mt:SetVar name="hero_alt" value="物流企業の未来を加速させるパートナー">
    <mt:SetVar name="loading" value="lazy">
    <mt:Include module="azcom-hero-fv-item">

    <!-- Slide 3 -->
    <mt:SetVar name="img_pc" value="fv-img-003.png">
    <mt:SetVar name="img_sp" value="fv-sp-img-003.png">
    <mt:SetVar name="line1" value="物流業界の課題を解決し">
    <mt:SetVar name="line2" value="パートナー企業の">
    <mt:SetVar name="line3" value="成長エンジンに">
    <mt:SetVar name="hero_alt" value="物流業界の課題を解決しパートナー企業の成長エンジンに">
    <mt:SetVar name="loading" value="lazy">
    <mt:Include module="azcom-hero-fv-item">

  </div>

  <!-- Controls — position:absolute inside .c-hero-fv -->
  <!-- Dots are auto-generated by JS based on slide count -->
  <div class="c-hero-fv__controls" aria-label="スライドコントロール">
    <button type="button" class="c-hero-fv__next" aria-label="次のスライドへ">
      <svg class="c-hero-fv__next-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

</section>
</div>
