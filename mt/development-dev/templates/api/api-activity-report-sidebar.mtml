<mt:Ignore>
  Output: /api/activity-report-sidebar.json
  Aggregates ranking, categories and tags for Activity-Report section.
</mt:Ignore>
<mt:Include module="azcom-env-config">
<mt:SetVar name="sidebar_section" value="activity-report">
<mt:SetVar name="sidebar_has_display_target" value="1">
<mt:SetVar name="article_query_lastn" value="150">
<mt:SetVar name="ranking_include_newsletter" value="0">
<mt:SetVar name="include_newsletter" value="0">
{
  "ranking": [
<mt:Include module="azcom-json-sidebar-ranking">
  ],
  "categories": [
<mt:Include module="azcom-json-sidebar-categories">
  ],
  "tags": [
<mt:Include module="azcom-json-sidebar-tags">
  ]
}
