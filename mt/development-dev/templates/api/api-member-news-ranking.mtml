<mt:Ignore>
  Output: news/api/member/news-ranking.json
  Top-5 ranking for the member audience (azcom-newsletter category is
  included, display_target must be member/both or the entry is newsletter).
  Reuses azcom-json-sidebar-ranking with sidebar_audience=member.
</mt:Ignore>
<mt:Include module="azcom-env-config">
<mt:Include module="azcom-member-config">
<mt:SetVar name="sidebar_section" value="news">
<mt:SetVar name="sidebar_has_display_target" value="1">
<mt:SetVar name="sidebar_audience" value="member">
<mt:SetVar name="ranking_blog_ids" value="$news_blog_id">
<mt:SetVar name="article_query_lastn" value="300">
{
  "ranking": [
<mt:Include module="azcom-json-sidebar-ranking">
  ]
}
