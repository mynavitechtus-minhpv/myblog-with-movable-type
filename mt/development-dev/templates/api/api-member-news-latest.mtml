<mt:Ignore>
  Output: /api/news/members/latest.json (News-blog Index Template)
  Five most recent member-visible entries. Scans up to 50 entries because
  member filtering discards ineligible ones; 50 is a comfortable ceiling
  even when many entries are corporate-only. Shape: {items: [...]}.

  Dev environment: azcom-article-cf-entry only runs when env_has_cf=1.
</mt:Ignore>
<mt:Include module="azcom-env-config">
<mt:Include module="azcom-member-config">

<mt:SetVar name="latest_render_count" value="0">
<mt:SetVar name="item_include_body" value="0">
{
  "items": [
<mt:Entries blog_ids="$news_blog_id" lastn="50" sort_by="authored_on" sort_order="descend">
  <mt:If name="latest_render_count" lt="5">
    <mt:SetVar name="cf_display_target" value="">
    <mt:SetVar name="cf_thumbnail_url" value="">
    <mt:If name="env_has_cf" eq="1">
      <mt:Include module="azcom-article-cf-entry">
    </mt:If>
    <mt:Include module="azcom-article-query-member">
    <mt:If name="is_member_visible" eq="1">
      <mt:Unless name="latest_render_count" eq="0">,
</mt:Unless>{<mt:Include module="azcom-json-article-item">}
      <mt:SetVar name="latest_render_count" op="++">
    </mt:If>
  </mt:If>
</mt:Entries>
  ]
}
