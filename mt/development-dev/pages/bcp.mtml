<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <mt:SetVarBlock name="meta_title">AZ-COMネットワークのBCP・災害支援 | AZ-COMネットワーク</mt:SetVarBlock>
    <mt:SetVarBlock name="meta_description">AZ-COMネットワークのBCP事業をご紹介。全国ネットワークによる災害支援体制を構築し、指定公共機関として被災地支援を実施。会員企業とともに物流から社会を支えます。</mt:SetVarBlock>
    <mt:SetVarBlock name="meta_canonical_url">https://www.azcom-net.jp/bcp/</mt:SetVarBlock>
    <mt:SetVar name="meta_og_image" value="assets/img/og-image_az-com-network.png">
    <mt:SetVar name="meta_og_type" value="website">
    <mt:Include module="azcom-head-meta">

    <mt:SetVar name="assets_version" value="20260422">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Old+Mincho:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/base.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/layout.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/utility.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/section-title.css?v=<$mt:Var name="assets_version" encode_html="1"$>">

    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/header.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/footer.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/floating-button.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/go-to-top.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/floating-inquiry.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/breadcrumb.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/key-visual.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/information-news.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/bcp.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/highlight-section.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/designated-public-card.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/designated-public-media.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/support-achievement-card.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/cta-button.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/image-pair.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/advisory-committee.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/advisory-what-card.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/network-corporate-efforts.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/lower-cta-section.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
</head>
<body>
    <!-- コンポーネント: ヘッダー -->
    <mt:Include module="azcom-header">

    <main class="p-bcp" id="main">
        <!-- コンポーネント: パンくず -->
        <mt:SetVarBlock name="breadcrumb_lv1_label">トップ</mt:SetVarBlock>
        <mt:SetVarBlock name="breadcrumb_lv1_url"><mt:Include module="azcom-site-root-path"></mt:SetVarBlock>
        <mt:SetVarBlock name="breadcrumb_current_label">AZ-COMネットワークのBCP・災害支援</mt:SetVarBlock>
        <mt:SetVar name="breadcrumb_show_jsonld" value="1">
        <mt:Include module="azcom-breadcrumb">

        <!-- コンポーネント: キービジュアル -->
        <mt:SetVar name="key_visual_section_id" value="bcp-key-visual">
        <mt:SetVar name="key_visual_heading_id" value="bcp-key-visual-heading">
        <mt:SetVar name="key_visual_bg_image_sp" value="fv-sp-img-004.png">
        <mt:SetVar name="key_visual_bg_image_pc" value="fv-img-004.png">
        <mt:SetVarBlock name="key_visual_title_text">AZ-COMネットワークのBCP・災害支援</mt:SetVarBlock>
        <mt:SetVarBlock name="key_visual_copy_html">AZ-COMネットワークは社会貢献活動の一環として、BCP・災害支援で日本最大級のプラットフォームとなることを目指しています</mt:SetVarBlock>
        <mt:Include module="azcom-key-visual">

        <!-- インフォメーション（お知らせ + 年間スケジュール） -->
        <section class="c-information" id="bcp-news" aria-labelledby="bcp-news-heading">
            <div class="l-container">
                <mt:SetVar name="section_title_id" value="bcp-news-heading">
                <mt:SetVarBlock name="section_title_text">BCP関連のお知らせ</mt:SetVarBlock>
                <mt:Include module="azcom-section-title">
                <div class="c-information__body">
                    <mt:SetVar name="information_news_lastn" value="5">
                    <mt:SetVar name="information_news_tag" value="BCP">
                    <mt:SetVar name="information_news_sort_by" value="authored_on">
                    <mt:SetVar name="information_news_sort_order" value="descend">
                    <mt:SetVar name="information_news_show_list_cta" value="1">
                    <mt:SetVar name="information_news_hide_heading" value="1">
                    <mt:Include module="azcom-information-news">
                </div>
            </div>
        </section>

        <section id="bcp-service" aria-labelledby="bcp-service-heading">
            <div class="l-container p-bcp__section-heading">
                <mt:SetVar name="section_title_id" value="bcp-service-heading">
                <mt:SetVarBlock name="section_title_text">AZ−COMネットワークのBCP事業</mt:SetVarBlock>
                <mt:Include module="azcom-section-title">
            </div>

            <!-- コンポーネント: BCP「AZ-COM BCPネットワークとは」 -->
            <mt:Include module="azcom-network-highlight">

            <!-- コンポーネント: BCP「BCP諮問委員会設立」 -->
            <mt:Include module="azcom-advisory-committee">

            <!-- コンポーネント: BCP「指定公共機関への指定」 -->
            <mt:Include module="azcom-designated-public-institution-highlight">
        </section>

        <!-- コンポーネント: 災害時の支援実績 -->
        <mt:Include module="azcom-support-achievement">

        <mt:Include module="azcom-network-corporate-efforts">

    </main>

    <!-- コンポーネント: フッター -->
    <mt:Include module="azcom-footer">

    <!-- コンポーネント: ページトップへ戻る -->
    <mt:SetVar name="go_to_top_href" value="#main">
    <mt:SetVarBlock name="go_to_top_aria_label">ページ先頭へ戻る</mt:SetVarBlock>
    <mt:SetVar name="go_to_top_text" value="TOP">
    <mt:Include module="azcom-go-to-top">

    <script defer src="<mt:Include module="azcom-site-root-path">assets/js/floating-inquiry.js?v=<$mt:Var name="assets_version" encode_html="1"$>"></script>
    <script defer src="<mt:Include module="azcom-site-root-path">assets/js/go-to-top.js?v=<$mt:Var name="assets_version" encode_html="1"$>"></script>
</body>
</html>
