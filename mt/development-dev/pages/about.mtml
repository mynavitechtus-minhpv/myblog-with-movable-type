<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <mt:SetVarBlock name="meta_title">AZ−COMネットワークの強み | AZ-COMネットワーク</mt:SetVarBlock>
    <mt:SetVarBlock name="meta_description">AZ-COMネットワークの強みをご紹介。共同購入やETC割引、人材育成、DX支援など、運送業の経営課題を解決する多彩な支援メニューで、会員企業の成長と財務安定を実現します。</mt:SetVarBlock>
    <mt:SetVarBlock name="meta_canonical_url">https://www.azcom-net.jp/about/</mt:SetVarBlock>
    <mt:SetVar name="meta_og_image" value="assets/img/og-image_az-com-network.png">
    <!-- コンポーネント: headメタ情報（title/description/canonical/OG） -->
    <mt:Include module="azcom-head-meta">

    <mt:SetVar name="assets_version" value="20260422">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Old+Mincho:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/base.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/layout.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/utility.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/section-title.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/about.css?v=<$mt:Var name="assets_version" encode_html="1"$>">

    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/header.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/footer.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/floating-button.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/go-to-top.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/floating-inquiry.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/subpage-hero.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/breadcrumb.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/network-strengths.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/support-menu.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/page-anchor-nav.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/lower-cta-section.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/join-guide-flow.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<mt:Include module="azcom-site-root-path">assets/css/member-feedback.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
</head>
<body>
    <!-- コンポーネント: グローバルヘッダー -->
    <mt:Include module="azcom-header">

    <main class="p-about" id="main">

        <mt:SetVarBlock name="breadcrumb_lv1_label">トップ</mt:SetVarBlock>
        <mt:SetVarBlock name="breadcrumb_lv1_url"><mt:Include module="azcom-site-root-path"></mt:SetVarBlock>
        <mt:SetVarBlock name="breadcrumb_current_label">AZ−COMネットワークの強み</mt:SetVarBlock>
        <mt:SetVar name="breadcrumb_show_jsonld" value="1">
        <!-- コンポーネント: パンくず -->
        <mt:Include module="azcom-breadcrumb">

        <mt:SetVar name="subpage_hero_bg" value="assets/img/sub-img-001.png">
        <mt:SetVarBlock name="subpage_hero_title">AZ−COMネットワークの強み</mt:SetVarBlock>
        <!-- コンポーネント: サブページヒーロー -->
        <mt:Include module="azcom-subpage-hero">

        <!-- コンポーネント: ページ内アンカーナビ -->
        <mt:Include module="azcom-page-anchor-nav">

        <section class="c-about-intro" id="about" aria-labelledby="about-intro-heading">
          <div class="c-about-intro__container l-container">
            <header class="c-about-intro__header">
              <mt:SetVar name="section_title_id" value="about-intro-heading">
              <mt:SetVarBlock name="section_title_text">AZ−COMネットワークとは</mt:SetVarBlock>
              <mt:Include module="azcom-section-title">
            </header>

            <div class="c-about-intro__body">
              <p class="c-about-intro__lead">AZ-COMネットワークの会員全員が主体となるプラットフォームへ</p>
              <p class="c-about-intro__desc">業界最大級の会員数を誇るAZ-COMネットワーク。"利他の精神"を礎に、物流資材の共同購入や人材育成、DX化推進など多彩な支援サービスを活用し、物流コスト削減や人材採用を多角的にサポートします。今後もサービス充実と会員数拡大に全力を尽くし、パートナー企業である会員の皆様の業務効率化と事業成長を力強く後押しします。</p>
            </div>

            <figure class="c-about-intro__network">
              <img src="<mt:Include module="azcom-site-root-path">assets/img/strong-img-001.png" alt="AZ-COMネットワークの会員構成と支援メニューの全体図" class="c-about-intro__network-img" width="780" height="780" loading="lazy">
            </figure>
          </div>
        </section>

        <!-- AZ-COMネットワークの強み -->
        <mt:SetVar name="network_strengths_id" value="strong-point">
        <mt:SetVar name="network_strengths_show_cta" value="0">
        <!-- コンポーネント: AZ-COMネットワークの強み -->
        <mt:Include module="azcom-network-strengths">

        <!-- コンポーネント: 下層CTAセクション -->
        <mt:Include module="azcom-lower-cta-section">

        <!-- 支援メニュー（コンテンツは azcom-support-menu モジュール内） -->
        <mt:Include module="azcom-support-menu">

        <!-- 入会のご案内（コンテンツは azcom-join-guide-flow モジュール内） -->
        <mt:Include module="azcom-join-guide-flow">

        <!-- 会員様の声（コンテンツは azcom-member-feedback モジュール内） -->
        <mt:Include module="azcom-member-feedback">

    </main>

    <!-- コンポーネント: グローバルフッター -->
    <mt:Include module="azcom-footer">

    <mt:SetVar name="floating_inquiry_show" value="1">
    <!-- コンポーネント: フローティングお問い合わせCTA -->
    <mt:Include module="azcom-floating-inquiry">

    <mt:SetVar name="go_to_top_href" value="#main">
    <mt:SetVarBlock name="go_to_top_aria_label">ページ先頭へ戻る</mt:SetVarBlock>
    <mt:SetVar name="go_to_top_text" value="TOP">
    <!-- コンポーネント: ページトップへ戻るボタン -->
    <mt:Include module="azcom-go-to-top">

    <script defer src="<mt:Include module="azcom-site-root-path">assets/js/page-anchor-nav.js?v=<$mt:Var name="assets_version" encode_html="1"$>"></script>
    <script defer src="<mt:Include module="azcom-site-root-path">assets/js/floating-inquiry.js?v=<$mt:Var name="assets_version" encode_html="1"$>"></script>
    <script defer src="<mt:Include module="azcom-site-root-path">assets/js/go-to-top.js?v=<$mt:Var name="assets_version" encode_html="1"$>"></script>
    <script defer src="<mt:Include module="azcom-site-root-path">assets/js/member-feedback.js?v=<$mt:Var name="assets_version" encode_html="1"$>"></script>
</body>
</html>
