<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <mt:SetVarBlock name="meta_title">AZ-COMネット ホームページ</mt:SetVarBlock>
    <mt:SetVarBlock name="meta_description">AZ-COMネット ホームページ</mt:SetVarBlock>
    <mt:Include module="azcom-head-meta">

    <mt:SetVar name="assets_version" value="20260327">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/base.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/layout.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/utility.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/home.css?v=<$mt:Var name="assets_version" encode_html="1"$>">

    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/header.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/footer.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/slider-infinite.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/floating-button.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/go-to-top.css?v=<$mt:Var name="assets_version" encode_html="1"$>">
    <link rel="stylesheet" href="<$mt:StaticWebPath encode_html="1"$>assets/css/floating-inquiry.css?v=<$mt:Var name="assets_version" encode_html="1"$>">

</head>
<body>
    <mt:Include module="azcom-header">
    <main class="p-top" id="main">
        
        <!-- Slider Infinite Logo Partners - Using Content Type "Slider" -->
        <section class="p-top__logo-slider-section" id="slider-partners-logo" aria-label="会員企業のロゴスライダー">
            <p class="p-top__logo-slider-heading">多くの会員様にご活用いただいています</p>
            <mt:Include module="azcom-slider-infinity" slider_key_value="top">
        </section>

    </main>

    <mt:Include module="azcom-footer">


    <!-- Floating Inquiry -->
    <mt:SetVar name="floating_inquiry_show" value="1">
    <mt:Include module="azcom-floating-inquiry">

    <!-- Go to Top Button -->
    <mt:SetVar name="go_to_top_href" value="#main">
    <mt:SetVarBlock name="go_to_top_aria_label">ページ先頭へ戻る</mt:SetVarBlock>
    <mt:SetVar name="go_to_top_text" value="TOP">
    <mt:Include module="azcom-go-to-top">

    <!-- Scripts -->
    <script defer src="<$mt:StaticWebPath encode_html="1"$>assets/js/slider-infinite.js?v=<$mt:Var name="assets_version" encode_html="1"$>"></script>
    <script defer src="<$mt:StaticWebPath encode_html="1"$>assets/js/floating-inquiry.js?v=<$mt:Var name="assets_version" encode_html="1"$>"></script>
    <script defer src="<$mt:StaticWebPath encode_html="1"$>assets/js/go-to-top.js?v=<$mt:Var name="assets_version" encode_html="1"$>"></script>
</body>
</html>
