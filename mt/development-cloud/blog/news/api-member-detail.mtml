<mt:Ignore>
  Output: /api/news/members/post_<EntryID>.json (Archive Template, Entry archive)
  Archive path in MT Admin: api/news/members/post_<$mt:EntryID$>.json
  Single-entry member payload (MT Data API v1-compatible item shape +
  body + prev_post/next_post). MT's EntryPrevious/EntryNext cannot
  honour CustomField filters, so prev/next are resolved by looping
  entries once in descending order and capturing the serialised JSON
  of the surrounding member-visible neighbours. A second
  `mt:Entries ids="$var"` lookup is avoided because MT does not
  substitute variables into the `ids` attribute reliably.
</mt:Ignore>
<mt:Include module="azcom-member-config">

<mt:SetVarBlock name="archive_entry_id"><$mt:EntryID$></mt:SetVarBlock>

<mt:SetVar name="detail_found" value="0">
<mt:SetVar name="detail_next_candidate_json" value="">
<mt:SetVar name="detail_next_json" value="">
<mt:SetVar name="detail_prev_json" value="">

<mt:Entries blog_ids="$news_blog_id" lastn="1000" sort_by="authored_on" sort_order="descend">
  <mt:Include module="azcom-article-cf-entry">
  <mt:Include module="azcom-article-query-member">
  <mt:If name="is_member_visible" eq="1">
    <mt:SetVarBlock name="loop_entry_id"><$mt:EntryID$></mt:SetVarBlock>
    <mt:If name="detail_found" eq="0">
      <mt:If name="loop_entry_id" eq="$archive_entry_id">
        <mt:SetVar name="detail_found" value="1">
        <mt:SetVar name="detail_next_json" value="$detail_next_candidate_json">
      <mt:Else>
        <mt:SetVar name="item_include_body" value="0">
        <mt:SetVarBlock name="detail_next_candidate_json"><mt:Include module="azcom-json-article-item"></mt:SetVarBlock>
      </mt:If>
    <mt:Else>
      <mt:If name="detail_prev_json" eq="">
        <mt:SetVar name="item_include_body" value="0">
        <mt:SetVarBlock name="detail_prev_json"><mt:Include module="azcom-json-article-item"></mt:SetVarBlock>
      </mt:If>
    </mt:If>
  </mt:If>
</mt:Entries>

<mt:Include module="azcom-article-cf-entry">
<mt:SetVar name="item_include_body" value="1">
{
  <mt:Include module="azcom-json-article-item">,
  "prev_post": <mt:If name="detail_prev_json">{<$mt:Var name="detail_prev_json"$>}<mt:Else>null</mt:If>,
  "next_post": <mt:If name="detail_next_json">{<$mt:Var name="detail_next_json"$>}<mt:Else>null</mt:If>
}
