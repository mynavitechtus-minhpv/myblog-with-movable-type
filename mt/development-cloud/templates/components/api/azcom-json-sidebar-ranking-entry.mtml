<mt:Ignore>
  Per-entry body for azcom-json-sidebar-ranking. Must run inside an
  MT:Entries context. Emits a complete JSON object wrapped in braces
  because this module is itself the per-iteration JSON node; item
  shape delegates to azcom-json-article-item (list mode) and is
  prefixed with "rank".

  Caller sets:
    rank_phase                  "1" pin pass (requires cf_ranking_enabled=1)
                                 "2" fill pass (entries not already pinned)
    sidebar_audience            "corporate" | "member"
    sidebar_has_display_target  "1" | "0"
    ranking_include_newsletter  "1" (default) | "0"
  Reads/updates: rank_count, rank_ids_rendered.
</mt:Ignore>
<mt:Unless name="ranking_include_newsletter">
  <mt:SetVar name="ranking_include_newsletter" value="1">
</mt:Unless>
<mt:If name="rank_count" lt="5">
  <mt:Include module="azcom-article-cf-entry">

  <mt:SetVar name="is_newsletter" value="0">
  <mt:EntryCategories>
    <mt:If tag="CategoryBasename" eq="azcom-newsletter">
      <mt:SetVar name="is_newsletter" value="1">
    </mt:If>
  </mt:EntryCategories>

  <mt:SetVar name="is_eligible" value="0">
  <mt:If name="sidebar_audience" eq="member">
    <mt:If name="is_newsletter" eq="1">
      <mt:If name="ranking_include_newsletter" eq="1">
        <mt:SetVar name="is_eligible" value="1">
      </mt:If>
    <mt:Else>
      <mt:If name="cf_display_target" eq="member"><mt:SetVar name="is_eligible" value="1"></mt:If>
      <mt:If name="cf_display_target" eq="both"><mt:SetVar name="is_eligible" value="1"></mt:If>
    </mt:If>
  <mt:Else>
    <mt:If name="is_newsletter" eq="0">
      <mt:If name="sidebar_has_display_target" eq="0">
        <mt:SetVar name="is_eligible" value="1">
      <mt:Else>
        <mt:If name="cf_display_target" eq="corporate"><mt:SetVar name="is_eligible" value="1"></mt:If>
        <mt:If name="cf_display_target" eq="both"><mt:SetVar name="is_eligible" value="1"></mt:If>
        <mt:If name="cf_display_target" eq=""><mt:SetVar name="is_eligible" value="1"></mt:If>
      </mt:If>
    <mt:Else>
      <mt:If name="ranking_include_newsletter" eq="1">
        <mt:If name="sidebar_has_display_target" eq="0">
          <mt:SetVar name="is_eligible" value="1">
        <mt:Else>
          <mt:If name="cf_display_target" eq="corporate"><mt:SetVar name="is_eligible" value="1"></mt:If>
          <mt:If name="cf_display_target" eq="both"><mt:SetVar name="is_eligible" value="1"></mt:If>
          <mt:If name="cf_display_target" eq=""><mt:SetVar name="is_eligible" value="1"></mt:If>
        </mt:If>
      </mt:If>
    </mt:If>
  </mt:If>

  <mt:SetVar name="rank_pass_ok" value="0">
  <mt:If name="rank_phase" eq="1">
    <mt:If name="cf_ranking_enabled" eq="1">
      <mt:SetVar name="rank_pass_ok" value="1">
    </mt:If>
  <mt:Else>
    <mt:SetVarBlock name="entry_id_check">,<$mt:EntryID$>,</mt:SetVarBlock>
    <mt:Unless name="rank_ids_rendered" like="$entry_id_check">
      <mt:SetVar name="rank_pass_ok" value="1">
    </mt:Unless>
  </mt:If>

  <mt:If name="rank_pass_ok" eq="1">
    <mt:If name="is_eligible" eq="1">
      <mt:Unless name="rank_count" eq="0">,</mt:Unless>
      <mt:SetVar name="rank_count" op="++">
      <mt:SetVar name="item_include_body" value="0">
      {
        "rank": <$mt:Var name="rank_count"$>,
        <mt:Include module="azcom-json-article-item">
      }
      <mt:If name="rank_phase" eq="1">
        <mt:SetVar name="rank_ids_rendered" value="$rank_ids_rendered<$mt:EntryID$>,">
      </mt:If>
    </mt:If>
  </mt:If>
</mt:If>
