<mt:Ignore>
  Top-5 ranking JSON items (no outer brackets).
  Two-phase selection: phase 1 emits entries with cf_ranking_enabled=1
  (manual pin); phase 2 fills remaining slots with the most recent
  entries not already pinned.

  Required caller vars:
    sidebar_section
    sidebar_has_display_target   "1" honours display_target, "0" ignores it
    article_query_lastn          max entries scanned per pass

  Optional caller vars:
    sidebar_audience             "corporate" (default) | "member"
    ranking_blog_ids             comma-separated blog IDs. Required when the
                                 template runs at Website/System scope;
                                 leave unset at Blog scope.
</mt:Ignore>
<mt:Unless name="sidebar_audience">
  <mt:SetVar name="sidebar_audience" value="corporate">
</mt:Unless>

<mt:SetVar name="rank_count" value="0">
<mt:SetVar name="rank_ids_rendered" value=",">

<mt:SetVar name="rank_phase" value="1">
<mt:If name="ranking_blog_ids">
  <mt:Entries blog_ids="$ranking_blog_ids" lastn="$article_query_lastn" sort_by="authored_on" sort_order="descend">
    <mt:Include module="azcom-json-sidebar-ranking-entry">
  </mt:Entries>
<mt:Else>
  <mt:Entries lastn="$article_query_lastn" sort_by="authored_on" sort_order="descend">
    <mt:Include module="azcom-json-sidebar-ranking-entry">
  </mt:Entries>
</mt:If>

<mt:If name="rank_count" lt="5">
  <mt:SetVar name="rank_phase" value="2">
  <mt:If name="ranking_blog_ids">
    <mt:Entries blog_ids="$ranking_blog_ids" lastn="$article_query_lastn" sort_by="authored_on" sort_order="descend">
      <mt:Include module="azcom-json-sidebar-ranking-entry">
    </mt:Entries>
  <mt:Else>
    <mt:Entries lastn="$article_query_lastn" sort_by="authored_on" sort_order="descend">
      <mt:Include module="azcom-json-sidebar-ranking-entry">
    </mt:Entries>
  </mt:If>
</mt:If>
