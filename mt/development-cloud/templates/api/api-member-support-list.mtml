<mt:Ignore>
  Output: support/api/member/support.json
  Member-visible Support entries in MT Data API v1-compatible shape
  ({totalResults, items[]}). Two-pass pattern so totalResults reflects the
  post-filter count. No per_page: member-site owns pagination.
</mt:Ignore>
<mt:Include module="azcom-member-config">

<mt:SetVar name="member_count" value="0">
<mt:Entries blog_ids="$support_blog_id" lastn="150" sort_by="authored_on" sort_order="descend">
  <mt:Include module="azcom-article-cf-entry">
  <mt:SetVar name="member_include_newsletter" value="0">
  <mt:Include module="azcom-article-query-member">
  <mt:If name="is_member_visible" eq="1"><mt:SetVar name="member_count" op="++"></mt:If>
</mt:Entries>
{
  "totalResults": <$mt:Var name="member_count"$>,
  "items": [
<mt:SetVar name="member_render_count" value="0">
<mt:SetVar name="item_include_body" value="0">
<mt:Entries blog_ids="$support_blog_id" lastn="150" sort_by="authored_on" sort_order="descend">
  <mt:Include module="azcom-article-cf-entry">
  <mt:SetVar name="member_include_newsletter" value="0">
  <mt:Include module="azcom-article-query-member">
  <mt:If name="is_member_visible" eq="1">
    <mt:Unless name="member_render_count" eq="0">,
</mt:Unless>{<mt:Include module="azcom-json-article-item">}
    <mt:SetVar name="member_render_count" op="++">
  </mt:If>
</mt:Entries>
  ]
}
