<mt:Ignore>
  Output: support/api/member/support-latest.json
  Five most recent member-visible Support entries. Shape: {items: [...]}.
</mt:Ignore>
<mt:Include module="azcom-member-config">

<mt:SetVar name="latest_render_count" value="0">
<mt:SetVar name="item_include_body" value="0">
{
  "items": [
<mt:Entries blog_ids="$support_blog_id" lastn="50" sort_by="authored_on" sort_order="descend">
  <mt:If name="latest_render_count" lt="5">
    <mt:Include module="azcom-article-cf-entry">
    <mt:SetVar name="member_include_newsletter" value="0">
    <mt:Include module="azcom-article-query-member">
    <mt:If name="is_member_visible" eq="1">
      <mt:Unless name="latest_render_count" eq="0">,
</mt:Unless>{<mt:Include module="azcom-json-article-item">}
      <mt:SetVar name="latest_render_count" op="++">
    </mt:If>
  </mt:If>
</mt:Entries>
  ]
}
