<mt:Ignore>
  Output: activity-report/api/member/activity-report-ranking.json
  Top-5 ranking for member audience in Activity-Report section.
</mt:Ignore>
<mt:Include module="azcom-member-config">
<mt:SetVar name="sidebar_section" value="activity-report">
<mt:SetVar name="sidebar_has_display_target" value="1">
<mt:SetVar name="sidebar_audience" value="member">
<mt:SetVar name="ranking_blog_ids" value="$activity_blog_id">
<mt:SetVar name="article_query_lastn" value="150">
{
  "ranking": [
<mt:Include module="azcom-json-sidebar-ranking">
  ]
}
